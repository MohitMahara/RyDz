generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum RideStatus {
  SEARCHING
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum KycStatus {
  NOT_STARTED
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum VehicleType {
  BIKE
  AUTO
  CAB_ECONOMY
  CAB_PREMIUM
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  DELETED
}


model User {
  id              String         @id @default(uuid(7))
  phoneNumber     String         @unique
  email           String?        @unique
  password        String?
  name            String?
  role            Role           @default(USER)
  avatarUrl       String?
  isPhoneVerified Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  driverProfile   DriverProfile?
  ridesAsRider    Ride[]         @relation("RiderRides")
  ridesAsDriver   Ride[]         @relation("DriverRides")
  payments        Payment[]
}

model DriverProfile {
  id              String       @id @default(uuid(7))
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  licenseNumber   String       @unique
  licenseExpiryDate DateTime?
  licenseVerified Boolean      @default(false)
  isAvailable     Boolean      @default(false) 
  kycStatus       KycStatus    @default(NOT_STARTED)
  activeVehicleId String?      @unique
  activeVehicle   Vehicle?     @relation("ActiveDriverVehicle", fields: [activeVehicleId], references: [id], onDelete: SetNull)

  rating          Float        @default(5.0)
  totalRides      Int          @default(0)
  totalRevenue    Float        @default(0.0)
  deletedAt       DateTime?
  
  // Relations
  vehicles        Vehicle[]    @relation("DriverVehicles")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Vehicle {
  id              String        @id @default(uuid(7))
 
  driverProfileId String
  driverProfile   DriverProfile @relation("DriverVehicles", fields: [driverProfileId], references: [id], onDelete: Cascade)
  activeForProfile DriverProfile? @relation("ActiveDriverVehicle")

  rides           Ride[]
  vehicleType     VehicleType
  make            String       
  model           String      
  plateNumber     String        @unique
  color           String
  status          VehicleStatus @default(ACTIVE)
  isVerified      Boolean       @default(false)
  deletedAt       DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Ride {
  id                 String       @id @default(uuid(7))

  riderId            String
  rider              User         @relation("RiderRides", fields: [riderId], references: [id])
  
  driverId           String?     
  driver             User?        @relation("DriverRides", fields: [driverId], references: [id])

  vehicleId          String?      
  vehicle            Vehicle?     @relation(fields: [vehicleId], references: [id])

  requestedVehicleType     VehicleType

  pickupLat          Float
  pickupLng          Float
  pickupAddress      String
  dropoffLat         Float
  dropoffLng         Float
  dropoffAddress     String
  status             RideStatus   @default(SEARCHING)
  otp                String       

  estimatedFare      Float
  finalFare          Float?    
  distanceInKm       Float
  durationInMinutes  Float?

  cancelledBy        Role?
  cancellationReason String?

  requestedAt        DateTime     @default(now())
  acceptedAt         DateTime?
  arrivedAt          DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?

  // Relations
  payment            Payment?
}

model Payment {
  id              String        @id @default(uuid(7))
  rideId          String        @unique
  ride            Ride          @relation(fields: [rideId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])

  amount          Float
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionId   String?     

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
